# Optional settings for running locally (node server.js). Restart after changes.
# Servers are added in the browser on first start — no config needed for them.

PORT=7575
CHECK_INTERVAL=30

# Plex "now playing"
PLEX_URL=
PLEX_TOKEN=

# Advanced: preconfigure servers instead of using the setup screen (only used when none are saved yet)
# UNRAID_NAME=Tower
# UNRAID_HOST=192.168.1.10
# UNRAID_URL=http://192.168.1.10:8080
# UNRAID_API_KEY=
# TRUENAS_NAME=NAS
# TRUENAS_HOST=192.168.1.20
# TRUENAS_API_KEY=
