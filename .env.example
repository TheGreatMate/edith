# Copy to .env and fill in. Restart after changes. Leave a server's HOST blank to hide it.

# Unraid — API key: Settings > Management Access > API Keys (viewer role is enough)
UNRAID_NAME=Tower
UNRAID_HOST=192.168.1.10
# Web UI URL, if it isn't http://UNRAID_HOST (e.g. moved to another port)
UNRAID_URL=
UNRAID_API_KEY=

# HexOS / TrueNAS SCALE — API key: https://<host>/ui/ > user icon > API Keys
TRUENAS_NAME=NAS
TRUENAS_HOST=192.168.1.20
TRUENAS_API_KEY=

# Optional: Plex "now playing"
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

PORT=7575
CHECK_INTERVAL=30
